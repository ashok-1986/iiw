# IIW Flipbook environment contract.
# SERVER-ONLY values — never prefix any Google credential with NEXT_PUBLIC_.

# Drive API key (project 878880461692). Used ONLY for drive/v3/files.list to enumerate
# portraits under Folder 2. Sheets data needs no key: the sheet is public and is read
# via the CSV/gviz export. NOTE: this same key has the Sheets API BLOCKED
# (API_KEY_SERVICE_BLOCKED) — do not try to use it for Sheets.
# SECURITY: this key was shared in plaintext; rotate it and restrict to Drive API only.
GOOGLE_DRIVE_API_KEY=

# Optional: Drive thumbnail requests via a quota-owning key. The proxy works without it
# for anyone-with-link files.
GOOGLE_SHEETS_API_KEY=

# Verified public folder IDs (PRD appendix; both confirmed Anyone-with-link 2026-10-17)
GOOGLE_DRIVE_FOLDER_1_ID=118jbchK0VSaeCZDCISX_rI94IZbyZi1o
GOOGLE_DRIVE_FOLDER_2_ID=18R9269jJWgs2yAWha9hdUjRZKb2e-TO8OqbqgJYojS6y54k-oodFg-iapCx7AV-v5W5rsgHx

# Secret token guarding /api/revalidate (Apps Script onEdit webhook, M5)
REVALIDATE_TOKEN=change-me-to-a-long-random-string

# Absolute public origin for metadataBase, OG images, sitemap and robots.
# Set in Vercel per environment (e.g. https://iiw.example.com). Left unset, the build
# falls back to http://localhost:3210 and share cards / canonicals point at localhost.
NEXT_PUBLIC_SITE_URL=
